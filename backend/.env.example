# Environment Configuration Example
# Copy this file to .env and fill in with your actual values

# ============ MYSQL CONFIGURATION ============
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=respire_user
MYSQL_PASSWORD=respire_password
MYSQL_DATABASE=respire_db

# For Docker Compose, use:
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=respire_user
# MYSQL_PASSWORD=respire_password
# MYSQL_DATABASE=respire_db

# ============ INFLUXDB CONFIGURATION ============
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influx_token_here
INFLUX_ORG=your_organization
INFLUX_BUCKET=respire_data

# For Docker Compose, use:
# INFLUX_URL=http://influxdb:8086
# INFLUX_TOKEN=your_influx_token
# INFLUX_ORG=your_org
# INFLUX_BUCKET=respire_data

# ============ JWT AUTHENTICATION ============
# Change this to a strong random string in production!
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============ API CONFIGURATION ============
API_DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000

# ============ LOGGING ============
LOG_LEVEL=INFO
